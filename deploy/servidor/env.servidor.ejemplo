# .env de ApiPago en el SERVIDOR (copiar a /opt/apipago/.env y completar).
# Solo Mercado Pago y TUU: Getnet y Transbank se cobran con la ApiPago de cada caja.

# Obligatorio para correr en el servidor.
MODO_SERVIDOR=true

# Puerto interno. Queda en 127.0.0.1: desde afuera se entra por nginx (HTTPS), nunca directo.
HTTP_PORT=5005
BIND_HOST=127.0.0.1

# Sucursal que atiende este servicio (también se completa sola al entrar al panel con la ApiKey).
ID_SUCURSAL=
NOMBRE_CAJA=SERVIDOR

# Dominio(s) del sistema web que llama a la API, separados por coma.
# IMPORTANTE en el servidor: si queda vacío, cualquier página web podría llamarla.
ALLOWED_ORIGINS=https://misistema.cl

TIMEOUT_SERVER=120
MAX_TRANSACTION_TIME=90

# ── Mercado Pago ──
USAR_MP=true
# Cajas que pueden cobrar con MP ("sucursal:caja" separadas por coma). Vacío = todas.
ALLOWED_MP=
MP_API_URL=https://api.mercadopago.com/v1/orders
MP_ACCESS_TOKEN=
# Terminales Point de la sucursal (separados por coma); el sistema web elige con mp_terminal_id.
MP_TERMINAL_ID=
ALLOW_MP_TOKEN_IN_REQUEST=false

# ── TUU ──
USAR_TUU=true
TUU_API_URL=https://integrations.payment.haulmer.com
TUU_API_KEY=
# Números de serie de las máquinas TUU (separados por coma).
TUU_DEVICES=
ALLOW_TUU_KEY_IN_REQUEST=false

# Días que se guardan los logs.
LOG_RETENCION_DIAS=60
