
# MODO DE APLICACIÓN

# "server" = Servidor central (una sola instancia)
# "agent" = Cliente/Agente (una por cada caja)
APP_MODE=agent

# Puerto HTTP (para servidor o agente)
HTTP_PORT=5000

# URL del servidor (solo para agentes)
SERVER_URL=http://192.168.1.100:5000

# ID de la sucursal (reemplaza CLIENT_ID)
ID_SUCURSAL=390

# Nombre de la caja (reemplaza BOX_ID)
NOMBRE_CAJA=caja_1

# ID del terminal POS (unificado para Transbank y Mercado Pago)
TERMINAL_ID=POS_01

# CONFIGURACIÓN DE POS FÍSICO

# ¿Esta máquina tiene POS físico conectado?
# true = Buscar y usar POS físico (Transbank)
# false = Solo procesar sin hardware
USAR_POS_FISICO=true

# Puertos COM preferidos (separados por coma)
PREFERRED_PORTS=COM7,COM6,COM8

# Timeout para polling (segundos)
POLL_TIMEOUT=10

# Tiempo máximo para una transacción POS (segundos)
MAX_TRANSACTION_TIME=90

# Timeout del servidor esperando respuesta del agente (segundos)
TIMEOUT=120

# Tiempo de espera antes de reconectar (segundos)
RECONNECT_DELAY=5

# MERCADO PAGO (Solo para servidor)

# Cajas autorizadas para usar Mercado Pago
# Formato: id_sucursal:nombre_caja,id_sucursal:nombre_caja
# Ejemplo: ALLOWED_MP=390:caja_1,390:caja_2,500:caja_principal
ALLOWED_MP=

# ============================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================

# --- CONFIGURACIÓN PARA SERVIDOR ---
# APP_MODE=server
# HTTP_PORT=5000
# ID_SUCURSAL=central
# NOMBRE_CAJA=servidor
# TIMEOUT=120
# ALLOWED_MP=390:caja_1,390:caja_2

# --- CONFIGURACIÓN PARA AGENTE CON POS FÍSICO ---
# APP_MODE=agent
# HTTP_PORT=5001
# SERVER_URL=http://192.168.1.100:5000
# ID_SUCURSAL=390
# NOMBRE_CAJA=caja_1
# TERMINAL_ID=POS_01
# USAR_POS_FISICO=true
# PREFERRED_PORTS=COM7,COM6,COM8
# MAX_TRANSACTION_TIME=90

# --- CONFIGURACIÓN PARA AGENTE SIN POS FÍSICO ---
# APP_MODE=agent
# HTTP_PORT=5002
# SERVER_URL=http://192.168.1.100:5000
# ID_SUCURSAL=390
# NOMBRE_CAJA=caja_virtual
# TERMINAL_ID=POS_VIRTUAL_01
# USAR_POS_FISICO=false