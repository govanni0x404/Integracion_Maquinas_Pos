# ============================================
# POS PAYMENT GATEWAY - CONFIGURACIÓN
# ============================================
# El mismo .exe corre en todas las máquinas
# Cada máquina es SERVER y AGENT al mismo tiempo

# ============================================
# PUERTO HTTP
# ============================================
# Puerto donde escucha esta máquina
HTTP_PORT=5001

# ============================================
# IDENTIFICACIÓN DE ESTA MÁQUINA
# ============================================
# ID de la sucursal
ID_SUCURSAL=680

# Nombre de esta caja (debe ser único por máquina)
# Si no se define, usa el nombre del PC automáticamente
NOMBRE_CAJA=caja_20

# ID del terminal POS
# Si no se define, usa POS_[nombre_caja]
TERMINAL_ID=POS_01

# ============================================
# POS FÍSICO (TRANSBANK)
# ============================================
# ¿Esta máquina tiene POS físico conectado?
# true = Busca y usa el POS Transbank
# false = Sin hardware físico
USAR_POS_FISICO=true

# Puertos COM a buscar (separados por coma, sin espacios)
PUERTOS_COM=COM7,COM6,COM8

# ============================================
# TIMEOUTS (en segundos)
# ============================================
# Tiempo máximo para una transacción en el POS
MAX_TRANSACTION_TIME=90

# Tiempo máximo que el servidor espera respuesta
TIMEOUT_SERVER=120

# ============================================
# MERCADO PAGO
# ============================================
# Cajas autorizadas para usar Mercado Pago (opcional)
# Formato: id_sucursal:nombre_caja,id_sucursal:nombre_caja
# Ejemplo: ALLOWED_MP=390:caja_1,390:caja_2,500:caja_principal
# Dejar vacío para permitir todas
ALLOWED_MP=680:caja_20,680:caja_21

